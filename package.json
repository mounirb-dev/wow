{
  "name": "agentsolver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "appwrite:up": "docker compose -f appwrite/docker-compose.yml up -d",
    "appwrite:down": "docker compose -f appwrite/docker-compose.yml down",
    "appwrite:bootstrap": "bun scripts/bootstrap-appwrite.mjs",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.mjs",
    "appwrite:configure": "bun --env-file=.env.local scripts/configure-appwrite.mjs",
    "appwrite:demo-user": "bun --env-file=.env.local scripts/create-demo-user.mjs",
    "appwrite:install": "bash scripts/appwrite-install.sh",
    "mcp": "bun --env-file=.env.local mcp/server.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "node-appwrite": "^31.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "tailwindcss": "^4"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
