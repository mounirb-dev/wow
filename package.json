{
  "name": "agentsolver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "appwrite:up": "docker compose -f appwrite/docker-compose.yml up -d",
    "appwrite:down": "docker compose -f appwrite/docker-compose.yml down",
    "appwrite:bootstrap": "bun scripts/bootstrap-appwrite.mjs",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.mjs",
    "appwrite:configure": "bun --env-file=.env.local scripts/configure-appwrite.mjs",
    "appwrite:install": "bash scripts/appwrite-install.sh",
    "news:sync": "bun --env-file=.env.local scripts/sync-news.mjs",
    "test": "bun test",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "node-appwrite": "^31.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "tailwindcss": "^4"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
