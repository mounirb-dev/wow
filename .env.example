# Written by `bun run appwrite:bootstrap` (you normally don't need to edit these)
APPWRITE_ENDPOINT=http://localhost:8080/v1
APPWRITE_PROJECT_ID=agentsolver
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=agentsolver
APPWRITE_STORAGE_BUCKET_ID=documents
APP_URL=http://localhost:3000
NEWS_SYNC_SECRET=change-this-in-production

# Google sign-in (optional) — see README, then run `bun run appwrite:configure`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in through Appwrite
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_P8_FILE=

# Clave para firmar los tokens OAuth del MCP (/mcp). Opcional: si falta se deriva de APPWRITE_API_KEY.
# Rotarla invalida todos los accesos MCP ya concedidos.
MCP_OAUTH_SECRET=

# Snyk (escaneo de dependencias y código en `bun run verify`). Token en https://app.snyk.io/account
SNYK_TOKEN=

